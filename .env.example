# Copy to .env in the project root for local development. On Vercel, add these in Project Settings > Environment Variables.

# Admin login (REQUIRED in production, there are no default passwords)
ADMIN_PASSWORD=choose-a-long-passphrase
JWT_SECRET=paste-a-long-random-string   # e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Database (REQUIRED on Vercel). Create a free database at turso.tech.
# Leave both empty locally and a file at backend/data/local.db is used.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Optional: get contact-form messages by email too (resend.com). They are always saved in the admin Inbox.
RESEND_API_KEY=
CONTACT_TO=you@example.com
CONTACT_FROM=Portfolio <onboarding@resend.dev>
